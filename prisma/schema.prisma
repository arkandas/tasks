generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StickyNoteColor {
  yellow
  blue
  green
  pink
  orange
  purple
  cyan
  red
  lime
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id         Int       @id @default(autoincrement())
  username   String    @unique
  email      String    @unique
  password   String?
  oidc_sub   String?   @unique
  role       UserRole  @default(USER)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  boards     Board[]
  stickyNotes StickyNote[]
  todoItems  TodoItem[]

  @@map("users")
}

model Board {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  position    Int       @default(0)
  user_id     Int
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sections    Section[]

  @@map("boards")
}

model Section {
  id         Int      @id @default(autoincrement())
  title      String
  position   Int      @default(0)
  board_id   Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  board      Board    @relation(fields: [board_id], references: [id], onDelete: Cascade)
  tasks      Task[]

  @@map("sections")
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  priority    Priority  @default(MEDIUM)
  position    Int       @default(0)
  deadline    DateTime?
  completed   Boolean   @default(false)
  section_id  Int
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  section     Section   @relation(fields: [section_id], references: [id], onDelete: Cascade)
  comments    Comment[]

  @@map("tasks")
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String
  task_id    Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  task       Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("comments")
}

model StickyNote {
  id         Int             @id @default(autoincrement())
  content    String
  color      StickyNoteColor @default(yellow)
  position_x Float           @default(0.0)
  position_y Float           @default(0.0)
  width      Int             @default(200)
  height     Int             @default(200)
  z_index    Int             @default(0)
  deleted_at DateTime?
  user_id    Int
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt

  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("stickynotes")
}

model TodoItem {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  priority    Priority  @default(MEDIUM)
  position    Int       @default(0)
  deadline    DateTime?
  completed   Boolean   @default(false)
  user_id     Int
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("todoitems")
}
